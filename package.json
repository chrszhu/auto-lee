{
  "name": "zhulol",
  "version": "0.5.0",
  "private": true,
  "description": "ZhuLoL - ad-free League of Legends champ-select companion: auto-imports runes, summoner spells, and item builds via the LCU API.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node test/verify.js && node test/verify-import.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^31.7.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.zhulol.app",
    "productName": "ZhuLoL",
    "copyright": "ZhuLoL. Not affiliated with Riot Games.",
    "directories": {
      "output": "dist-installers",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "data/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "ZhuLoL-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.utilities"
    },
    "dmg": {
      "artifactName": "ZhuLoL-${version}.${ext}"
    }
  }
}
